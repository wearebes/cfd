{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Basilisk: 准备运行目录",
            "type": "process",
            "command": "/bin/mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/tem/vscode_basilisk/${fileBasenameNoExtension}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Basilisk/qcc: 生成活动文件",
            "type": "cppbuild",
            "command": "${workspaceFolder}/basilisk/src/qcc",
            "args": [
                "-g",
                "-O2",
                "-Wall",
                "${fileBasename}",
                "-o",
                "${workspaceFolder}/tem/vscode_basilisk/${fileBasenameNoExtension}/solver",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "BASILISK": "${workspaceFolder}/basilisk/src"
                }
            },
            "dependsOn": "Basilisk: 准备运行目录",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Basilisk/qcc: 运行活动文件",
            "type": "process",
            "command": "${workspaceFolder}/tem/vscode_basilisk/${fileBasenameNoExtension}/solver",
            "options": {
                "cwd": "${workspaceFolder}/tem/vscode_basilisk/${fileBasenameNoExtension}"
            },
            "dependsOn": "Basilisk/qcc: 生成活动文件",
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
