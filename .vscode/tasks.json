{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Basilisk/qcc: 生成活动文件",
            "command": "${workspaceFolder}/tools/basilisk-cc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lm"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Use the repository Basilisk compiler wrapper instead of VS Code generated gcc tasks."
        },
        {
            "type": "shell",
            "label": "Basilisk/qcc: 运行活动文件",
            "command": "${workspaceFolder}/tools/basilisk-run",
            "args": [
                "${file}"
            ],
            "problemMatcher": [],
            "group": "test",
            "detail": "Build the active file with the repository Basilisk wrapper, then run it from the source directory."
        }
    ]
}
