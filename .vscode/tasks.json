{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang 生成活动文件",
            "command": "/bin/zsh",
            "args": [
                "-lc",
                "if [[ \"${file}\" == *\"/basilisk/src/\"* ]]; then srcfile=\"${file}\"; srcfile=\"${srcfile#${workspaceFolder}/basilisk/src/}\"; cd \"${workspaceFolder}/basilisk/src\" && ./qcc -autolink \"$srcfile\" -o \"${fileDirname}/${fileBasenameNoExtension}\" -lm; else /usr/bin/clang -fcolor-diagnostics -fansi-escape-codes -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\"; fi"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-15 生成活动文件",
            "command": "/opt/homebrew/bin/gcc-15",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}
